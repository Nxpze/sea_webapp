# Database Configuration (YugabyteDB Cloud / PostgreSQL)
DB_HOST=your-yugabyte-host.aws.yugabyte.cloud
DB_PORT=5433
DB_NAME=travel_sea
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=postgresql://your_db_username:your_db_password@your-yugabyte-host.aws.yugabyte.cloud:5433/travel_sea?sslmode=require

# Supabase Storage Configuration (Private bucket: payment-slips)
SUPA_URL=https://your-project.supabase.co
SUPA_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPA_SECRET_KEY=your_supabase_service_role_secret_key

# Authentication
SHARED_PASSWORD=your_shared_group_password
SESSION_SECRET=your_random_32_bytes_session_secret
